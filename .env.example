# Copy to .env.local (dev) or your host's env vars (production). Never commit real values.

# Neon Postgres connection string (pooled endpoint recommended for the app)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Cloudflare Turnstile — optional in dev; set in production to enable bot verification
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
